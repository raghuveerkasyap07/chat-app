<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sdk_window_background">

    <!-- Header / Status Bar -->
    <LinearLayout
        android:id="@+id/layoutSdkHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sdk_primary_600"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSdkHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sdk_title_chat"
            android:textColor="@color/sdk_surface_card"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewSdkStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/sdk_bg_status_dot_disconnected" />

            <TextView
                android:id="@+id/tvSdkStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sdk_status_disconnected"
                android:textColor="@color/sdk_primary_100"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSdkChatMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/suggestionsScroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSdkHeader"
        tools:listitem="@layout/sdk_item_chat_received" />

    <!-- Horizontal Suggestions ScrollView -->
    <HorizontalScrollView
        android:id="@+id/suggestionsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/layoutSdkInputCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipHello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/sdk_bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/sdk_suggestion_hello"
                android:textColor="@color/sdk_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipEcho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/sdk_bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/sdk_suggestion_echo"
                android:textColor="@color/sdk_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/sdk_bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/sdk_suggestion_ping"
                android:textColor="@color/sdk_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipHowAreYou"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/sdk_bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/sdk_suggestion_how_are_you"
                android:textColor="@color/sdk_chip_text"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Input Area -->
    <LinearLayout
        android:id="@+id/layoutSdkInputCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/sdk_bg_input_card"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/etSdkMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/sdk_type_a_message"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingVertical="8dp"
            android:textColor="@color/sdk_text_primary"
            android:textColorHint="@color/sdk_text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSdkSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/sdk_send"
            android:src="@drawable/sdk_ic_send"
            app:backgroundTint="@color/sdk_primary_600"
            app:elevation="2dp"
            app:fabCustomSize="42dp"
            app:tint="@color/sdk_surface_card" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
